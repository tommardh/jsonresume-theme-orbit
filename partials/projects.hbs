{{#if resume.projects}}
    <section class="section projects-section">
        <h2 class="section-title"><i class="fa fa-archive"></i>{{#if (eq meta.language 'swe')}}Projekt{{else}}Projects{{/if}}</h2>
        
        {{#resume.projects}}
            <div class="item">
                <div class="meta">
                    <div class="upper-row">
                        {{#if (eq ../meta.projectFocus 'role')}}
                        <h3 class="work-header">{{position}}</h3>
                        {{else}}
                        <h3 class="work-header">{{name}}</h3>
                        {{/if}}
                        <div class="time">{{#if location}}{{location}}, {{/if}}{{year startDate}} - {{year endDate}}</div>
                    </div><!--//upper-row-->
                    {{#if (eq ../meta.projectFocus 'role')}}
                    <div class="work-sub-header">{{#if url}}<a href="{{url}}" target="_blank">{{/if}}{{name}}{{#if url}}</a>{{/if}}</div>
                    {{else}}
                    <div class="work-sub-header">{{#if url}}<a href="{{url}}" target="_blank">{{/if}}{{position}}{{#if url}}</a>{{/if}}</div>
                    {{/if}}
                </div><!--//meta-->
                {{#if (neq ../meta.projectLevel 'none')}}
                <div class="details">
                    {{#if (eq ../meta.projectLevel 'summary')}}
                    {{#markdown}}{{summary}}{{/markdown}}
                    {{else}}
                    {{#markdown}}{{description}}{{/markdown}}
                    {{/if}}
                </div><!--//details-->
                {{/if}}
                {{#if ../meta.projectHighlights}}
                {{#if highlights}}
                <p>
                <ul>
                    {{#highlights}}
                    <li>{{this}}</li>
                    {{/highlights}}
                </ul>
                </p>
                {{/if}}
                {{/if}}
            </div><!--//item-->
        {{/resume.projects}}
    </section><!--//section-->
{{/if}}
