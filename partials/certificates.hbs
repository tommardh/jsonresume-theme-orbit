{{#if resume.certificates}}
    <div class="education-container container-block">
        <h2 class="container-block-title">{{#if (eq meta.language 'swe')}}Certifikat{{else}}Certificates{{/if}}</h2>
        {{#resume.certificates}}
            <div class="item">
                <h4 class="degree">{{name}}</h4>
                <h5 class="meta">{{issuer}}</h5>
                <div class="time">{{year date}}</div>
            </div><!--//item-->
        {{/resume.certificates}}
    </div><!--//education-container-->
{{/if}}
