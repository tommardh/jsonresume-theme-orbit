{{#if resume.skills}}
    <section class="skills-section section">
        <h2 class="section-title"><i class="fa fa-rocket"></i>{{#if (eq meta.language 'swe')}}Kompetenser{{else}}Skills &amp; Proficiency{{/if}}</h2>
        <div class="skillset">
            {{#resume.skills}}
                <div class="item">
                    <h3 class="level-title">{{name}}</h3>
                    <div class="level-right">
                        <div class="level-bar">
                            <div class="level-bar-inner" data-level="{{skillLevel level}}">
                            </div>
                        </div><!--//level-bar-->
                        {{#if ../meta.skillKeywords}}
                        {{#if keywords}}
                        <div class="keywords">{{#each keywords}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</div>
                        {{/if}}
                        {{/if}}
                    </div>
                </div><!--//item-->
            {{/resume.skills}}

        </div>
    </section><!--//skills-section-->
{{/if}}