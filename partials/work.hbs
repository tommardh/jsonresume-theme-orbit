{{#if resume.work}}
    <section class="section experiences-section">
        <h2 class="section-title"><i class="fa fa-briefcase"></i>{{#if (eq meta.language 'swe')}}Arbetserfarenhet{{else}}Work Experience{{/if}}</h2>

        {{#if (eq meta.workFocus 'company')}}
            {{#groupByCompany resume.work}}
                <div class="item">
                    <h3 class="work-header">{{company}}</h3>
                    {{#positions}}
                        {{#if (isAfterDate endDate ../../meta.startDate)}}
                        <div class="position-entry">
                            <div class="meta">
                                <div class="upper-row">
                                    <div class="work-sub-header">{{#if url}}<a href="{{url}}" target="_blank">{{/if}}{{position}}{{#if url}}</a>{{/if}}</div>
                                    <div class="time">{{#if location}}{{location}}, {{/if}}{{year startDate}} - {{year endDate}}</div>
                                </div><!--//upper-row-->
                            </div><!--//meta-->
                            {{#if (neq ../../meta.workLevel 'none')}}
                            <div class="details">
                                {{#if (eq ../../meta.workLevel 'description')}}
                                {{#markdown}}{{description}}{{/markdown}}
                                {{else}}
                                {{#markdown}}{{summary}}{{/markdown}}
                                {{/if}}
                            </div><!--//details-->
                            {{/if}}
                            {{#if ../../meta.workHighlights}}
                            {{#if highlights}}
                            <p>
                            <ul>
                                {{#highlights}}
                                <li>{{this}}</li>
                                {{/highlights}}
                            </ul>
                            </p>
                            {{/if}}
                            {{/if}}
                        </div><!--//position-entry-->
                        {{/if}}
                    {{/positions}}
                </div><!--//item-->
            {{/groupByCompany}}
        {{else}}
            {{#resume.work}}
                {{#if (isAfterDate endDate ../meta.startDate)}}
                <div class="item">
                    <div class="meta">
                        <div class="upper-row">
                            <h3 class="work-header">{{position}}</h3>
                            <div class="time">{{#if location}}{{location}}, {{/if}}{{year startDate}} - {{year endDate}}</div>
                        </div><!--//upper-row-->
                        <div class="work-sub-header">{{#if url}}<a href="{{url}}" target="_blank">{{/if}}{{name}}{{#if url}}</a>{{/if}}</div>
                    </div><!--//meta-->
                    {{#if (neq ../meta.workLevel 'none')}}
                    <div class="details">
                        {{#if (eq ../meta.workLevel 'description')}}
                        {{#markdown}}{{description}}{{/markdown}}
                        {{else}}
                        {{#markdown}}{{summary}}{{/markdown}}
                        {{/if}}
                    </div><!--//details-->
                    {{/if}}
                    {{#if ../meta.workHighlights}}
                    {{#if highlights}}
                    <p>
                    <ul>
                        {{#highlights}}
                        <li>{{this}}</li>
                        {{/highlights}}
                    </ul>
                    </p>
                    {{/if}}
                    {{/if}}
                </div><!--//item-->
                {{/if}}
            {{/resume.work}}
        {{/if}}
    </section><!--//section-->
{{/if}}